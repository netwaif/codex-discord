# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# 쉼표 구분 Discord 사용자 ID (개발자 모드 켜고 프로필 우클릭 > ID 복사)
ALLOWED_USER_IDS=

# Codex가 작업할 프로젝트 폴더 (절대경로)
CODEX_WORKDIR=

# (권장) codex 바이너리 절대경로 — npm이 PATH를 바꿔도 버전이 고정됨. 미설정 시 PATH의 codex 사용
CODEX_BIN=

# ── 라이브 TUI 모드 (선택) ──
# 지정하면 해당 채널이 tmux pane의 codex TUI 세션과 연결된다.
# 둘 다 비우면 v1 headless 동작만 한다. 권장값: codex-live:0.0 (scripts/tui-up.sh가 이 세션을 만든다)
TUI_PANE=codex-live:0.0
TUI_CHANNEL_ID=
# TUI 채널 아래 디스코드 스레드마다 전용 창(codex/agy 세션)을 띄워 스레드에 답한다(기본 on).
# 공유 수다 채널을 TUI 채널로 쓰는 배치에서 스레드까지 세션을 만들고 싶지 않으면 off.
TUI_THREADS=

# ── 인스턴스/전용 채널 (선택) ──
# 전용 채널 봇(폴더 봇)은 off — 호명(멘션·이름) 없이 모든 메시지에 응답한다.
# 기본 on = 공유 수다 채널을 TUI 채널로 쓰는 배치의 호명 게이트 유지.
TUI_TRIGGER_GATE=
# 봇 인스턴스를 늘릴 때는 .env.<이름> 파일로 분리하고(예: .env.collab)
# scripts/tui-up.sh .env.<이름> / node --env-file=.env.<이름> src/index.mjs 로 띄운다.
# DATA_DIR=data-<이름> 지정 필수(데몬 락·세션맵 분리). folder-bot 플러그인이 자동 구성.

# codex TUI 샌드박스 끄기(off) — 도커 컨테이너처럼 bwrap이 못 도는 환경 전용. 맥은 비워 둔다.
# CODEX_TUI_SANDBOX=off
